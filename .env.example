# Email OTP — on Render prefer HTTPS API (SMTP ports are often blocked):
# 1) Resend (recommended): https://resend.com → API Key
#    RESEND_API_KEY=re_xxxx
#    DEFAULT_FROM_EMAIL=AI Assistant <onboarding@resend.dev>
#    (or your verified domain: AI Assistant <noreply@yourdomain.com>)
# 2) Or Brevo: BREVO_API_KEY=...  BREVO_SENDER_EMAIL=you@domain.com
# SMTP (Gmail etc.) often fails on Render with: Network is unreachable
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=AI Assistant <you@gmail.com>
